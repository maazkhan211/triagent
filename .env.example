# Everything runs locally against Ollama -- there are no API keys in this project.
OLLAMA_HOST=http://localhost:11434

# The reasoning model. llama3.2:3b is the default: measured 3.5x faster than
# llama3.1 (8B) on CPU while scoring identically (5/8) on the severity eval.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION=incidents
